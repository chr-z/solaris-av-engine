# Dummy Firebase env for OFFLINE E2E runs (acoustic_e2e.mjs).
# Values are placeholders so the compat SDK boots without the FATAL
# "Can't determine Firebase Database URL" crash; cloud calls stay blocked
# via CDP Network.setBlockedURLs in the script.
# Copy to .env.e2e before running: cp .env.e2e.example .env.e2e
# Then: npm run build -- --mode e2e && npx vite preview --port <p>
VITE_FIREBASE_API_KEY=dummy-e2e-key
VITE_FIREBASE_AUTH_DOMAIN=e2e.invalid
VITE_FIREBASE_DATABASE_URL=https://e2e-dummy-default.firebaseio.com
VITE_FIREBASE_PROJECT_ID=e2e-project
VITE_FIREBASE_STORAGE_BUCKET=e2e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:000000000000:web:e2edummy

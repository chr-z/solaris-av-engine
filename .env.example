# Solaris AV Engine — environment template.
# Copy to .env (gitignored) and fill in your own values. NEVER commit .env.

# Google Cloud (Sheets/Drive/YouTube picker)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Firebase client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# --- Solaris Pro licensing (S6.1) -------------------------------------------
# Edition override baked into the build: unset = free by default, "pro" forces
# Pro for that deployment. Client-side values are public by design.
# VITE_SOLARIS_EDITION=free

# HMAC secret used ONLY by scripts/gen_license_key.mjs to sign keys. Keep it in
# your local env / CI secrets — never in VITE_ vars (those ship to browsers).
# SOLARIS_LICENSE_SECRET=
